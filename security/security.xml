<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_facturafacil" model="ir.module.category">
        <field name="name">Factura Fácil Panamá</field>
        <field name="description">Facturación Electrónica de Panamá</field>
        <field name="sequence">50</field>
    </record>

    <record id="privilege_facturafacil" model="res.groups.privilege">
        <field name="name">Factura Fácil Panamá</field>
        <field name="category_id" ref="module_category_facturafacil"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_ff_user" model="res.groups">
        <field name="name">Usuario FE</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_facturafacil"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Puede enviar facturas a Factura Fácil</field>
    </record>

    <record id="group_ff_admin" model="res.groups">
        <field name="name">Administrador FE</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_facturafacil"/>
        <field name="implied_ids" eval="[(4, ref('group_ff_user'))]"/>
        <field name="comment">Puede configurar credenciales y ver logs de Factura Fácil</field>
    </record>

    <!-- Multi-company rule for ff.log -->
    <record id="ff_log_comp_rule" model="ir.rule">
        <field name="name">FF Log multi-company</field>
        <field name="model_id" ref="model_ff_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
