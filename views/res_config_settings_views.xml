<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ff" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ff</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Factura Fácil Panamá" name="facturafacil_settings">
                    <setting id="ff_environment_setting" string="Ambiente" help="Seleccione el ambiente del API de Factura Fácil">
                        <field name="ff_environment" class="o_light_label"/>
                    </setting>
                    <setting id="ff_api_url_setting" string="URL del API" help="URL del endpoint del API de Factura Fácil">
                        <field name="ff_api_url" class="o_light_label"/>
                    </setting>
                    <setting id="ff_company_uuid_setting" string="X-FF-Company" help="UUID de la compañía en Factura Fácil">
                        <field name="ff_company_uuid" class="o_light_label" password="True"/>
                    </setting>
                    <setting id="ff_branch_uuid_setting" string="X-FF-Branch" help="UUID de la sucursal en Factura Fácil">
                        <field name="ff_branch_uuid" class="o_light_label" password="True"/>
                    </setting>
                    <setting id="ff_api_key_setting" string="X-FF-API-Key" help="API Key de Factura Fácil">
                        <field name="ff_api_key" class="o_light_label" password="True"/>
                    </setting>
                    <setting id="ff_sucursal_setting" string="Código de Sucursal" help="Código de sucursal (4 caracteres alfanuméricos)">
                        <field name="ff_sucursal" class="o_light_label"/>
                    </setting>
                    <setting id="ff_caja_setting" string="Número de Caja" help="Número de caja/punto de venta (3 dígitos)">
                        <field name="ff_caja" class="o_light_label"/>
                    </setting>
                    <setting id="ff_auto_send_setting" string="Envío Automático" help="Enviar automáticamente al confirmar la factura">
                        <field name="ff_auto_send"/>
                    </setting>
                    <setting id="ff_max_retries_setting" string="Máximo de Reintentos" help="Número máximo de reintentos para envíos fallidos">
                        <field name="ff_max_retries" class="o_light_label"/>
                    </setting>
                    <setting>
                        <button name="action_ff_test_connection" type="object"
                                string="Probar Conexión" class="btn-primary"
                                icon="fa-plug"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
