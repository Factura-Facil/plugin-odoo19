<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tax_form_ff" model="ir.ui.view">
        <field name="name">account.tax.form.ff</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']" position="after">
                <page string="Factura Fácil Panamá" name="facturafacil">
                    <group>
                        <field name="ff_itbms_code"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
